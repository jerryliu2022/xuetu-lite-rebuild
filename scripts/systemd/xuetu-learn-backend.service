# 岳阳学院智慧校园 —— 后端服务（uvicorn :8000）
#
# 使用前先按你的服务器改这两处：
#   1) WorkingDirectory  → 代码实际路径
#   2) ExecStart         → python3 和 uvicorn 的绝对路径，用 `which python3` 查
#
# 安装：
#   sudo cp scripts/systemd/xuetu-learn-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now xuetu-learn-backend
#
# 常用：
#   systemctl status  xuetu-learn-backend
#   systemctl restart xuetu-learn-backend
#   journalctl -u xuetu-learn-backend -f
[Unit]
Description=Xuetu Lite 学途学习模块------------推荐服务
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/project/xuetu/xuetu-lite-rebuild
ExecStart=/home/project/xuetu/xuetu-lite-rebuild/venv/bin/python  -m uvicorn learn.server.app:app --app-dir learn --host 0.0.0.0 --port 8766 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF